part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 130M
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_a --align 4096 --size 800M
part --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_b --align 4096 --size 800M
part /data --fstype=ext4 --ondisk mmcblk0 --label data --align 4096 --size 21000M --fsuuid "${DATA_PART_UUID}"
